{
  "name": "ai-resume-tailor",
  "version": "1.0.0",
  "description": "AI-powered resume tailoring: paste a resume and a job posting, get an honestly tailored, ATS-optimized resume with match scoring, gap analysis, and a cover letter. Powered by Claude Opus 5.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node --experimental-strip-types scripts/check-windows-sensitive-paths.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "submission-attempt:recover": "node --experimental-strip-types scripts/recover-submission-attempt.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "docx": "^9.7.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "jszip": "3.10.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "<6.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "sharp": "^0.35.3",
    "postcss": "^8.5.25"
